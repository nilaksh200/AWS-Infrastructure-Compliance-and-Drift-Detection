# ==============================================================================
# Terraform Git Ignore Rules
# ==============================================================================

# Local .terraform directories containing provider plugins and modules
**/.terraform/*
**/.terraform/

# Terraform state and plan files containing potential sensitive data
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfplan
tfplan

# Crash log files
crash.log
crash.*.log

# Exclude local variable definitions files containing actual configuration values
*.tfvars
*.tfvars.json

# Retain example variable definition templates
!*.tfvars.example

# Ignore local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# ==============================================================================
# Credentials and Environment Secrets
# ==============================================================================
.aws/
*.pem
*.key
credentials
.env
.env.*

# ==============================================================================
# OS and Editor Artefacts
# ==============================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ==============================================================================
# Python Artifacts & Virtual Environments
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

